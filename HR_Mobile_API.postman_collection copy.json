        },
        {
          "name": "res.users — read (own)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/mobile/jsonrpc", "host": ["{{base_url}}"], "path": ["mobile","jsonrpc"] },
            "body": { "mode": "raw", "raw": "{\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\"{{db}}\", 0, \"{{mobile_token}}\", \"res.users\", \"search_read\", [[]], {\"fields\": [\"name\",\"login\",\"lang\"]}]\n  }\n}" } }
        }
      ]
    },
    {
      "name": "2. Face Attendance — OLD",
      "item": [
        {
          "name": "GET /face_attendance (status)",
          "request": { "method": "GET", "header": [],
            "url": { "raw": "{{base_url}}/face_attendance", "host": ["{{base_url}}"], "path": ["face_attendance"] } }
        },
        {
          "name": "POST /submit_face (image + GPS)",
          "request": { "method": "POST", "header": [],
            "url": { "raw": "{{base_url}}/submit_face", "host": ["{{base_url}}"], "path": ["submit_face"] },
            "body": { "mode": "formdata", "formdata": [
              { "key": "mobile_token", "value": "{{mobile_token}}", "type": "text" },
              { "key": "face_image", "value": "<base64-or-dataURL>", "type": "text" },
              { "key": "latitude", "value": "24.7136", "type": "text" },
              { "key": "longitude", "value": "46.6753", "type": "text" },
              { "key": "address", "value": "Riyadh, Saudi Arabia", "type": "text" }
            ] } }
        }
      ]
    },
