{
  "info": {
    "name": "HR Mobile API — Full (Odoo 18)",
    "description": "Complete collection for the Flutter HR app: OLD generic endpoints (/mobile/web, /mobile/jsonrpc whitelist, /submit_face) AND the NEW dedicated structured endpoints (/mobile/profile, /mobile/leaves, /mobile/payslips, /mobile/attendance/*, /mobile/notifications). Authenticate once (folder 0) to auto-store mobile_token, then use any request.\n\nTEST SERVER (demo data preloaded): base_url=http://168.231.106.200:8193 , db=hr_mobile_test , login(barcode)=EMP001 , password(PIN)=1234. A manager MGR001/1234 also exists. Sample data: 2 leaves (1 with refusal reason), 1 payslip with lines, 2 notifications.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://168.231.106.200:8193" },
    { "key": "db", "value": "hr_mobile_test" },
    { "key": "barcode", "value": "EMP001" },
    { "key": "pin", "value": "1234" },
    { "key": "mobile_token", "value": "" },
    { "key": "employee_id", "value": "" }
  ],
  "item": [
    {
      "name": "0. Auth (token)",
      "item": [
        {
          "name": "GET /mobile/web (landing cookie)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/mobile/web", "host": ["{{base_url}}"], "path": ["mobile","web"] }
          }
        },
        {
          "name": "POST /mobile/web/session/authenticate (barcode + PIN)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const r = pm.response.json();",
            "if (r.result) {",
            "  if (r.result.mobile_token) pm.collectionVariables.set('mobile_token', r.result.mobile_token);",
            "  if (r.result.employee_id) pm.collectionVariables.set('employee_id', r.result.employee_id);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/mobile/web/session/authenticate", "host": ["{{base_url}}"], "path": ["mobile","web","session","authenticate"] },
            "body": { "mode": "raw", "raw": "{\n  \"params\": {\n    \"db\": \"{{db}}\",\n    \"login\": \"{{barcode}}\",\n    \"password\": \"{{pin}}\"\n  }\n}" }
          }
        },
        {
          "name": "POST /mobile/web/session/check",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{mobile_token}}" }],
            "url": { "raw": "{{base_url}}/mobile/web/session/check", "host": ["{{base_url}}"], "path": ["mobile","web","session","check"] },
            "body": { "mode": "raw", "raw": "{\n  \"params\": {}\n}" }
          }
        }
      ]
    },
    {
      "name": "1. Generic RPC (/mobile/jsonrpc) — OLD",
      "description": "Whitelisted execute_kw proxy. args = [db, uid(ignored), token, model, method, [positional], {kwargs}]. Token goes in args[2].",
      "item": [
        {
          "name": "hr.employee — search_read (own profile)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/mobile/jsonrpc", "host": ["{{base_url}}"], "path": ["mobile","jsonrpc"] },
            "body": { "mode": "raw", "raw": "{\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\"{{db}}\", 0, \"{{mobile_token}}\", \"hr.employee\", \"search_read\", [[]], {\"fields\": [\"name\",\"job_title\",\"department_id\",\"work_email\",\"work_phone\",\"barcode\",\"attendance_state\",\"parent_id\",\"work_location_id\"]}]\n  }\n}" } }
        },
        {
          "name": "hr.attendance — search_read",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/mobile/jsonrpc", "host": ["{{base_url}}"], "path": ["mobile","jsonrpc"] },
            "body": { "mode": "raw", "raw": "{\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\"{{db}}\", 0, \"{{mobile_token}}\", \"hr.attendance\", \"search_read\", [[]], {\"fields\": [\"check_in\",\"check_out\",\"worked_hours\",\"in_latitude\",\"in_longitude\",\"in_address\",\"geofence_status\"], \"limit\": 30, \"order\": \"check_in desc\"}]\n  }\n}" } }
        },
        {
          "name": "hr.attendance — create (check-in)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/mobile/jsonrpc", "host": ["{{base_url}}"], "path": ["mobile","jsonrpc"] },
            "body": { "mode": "raw", "raw": "{\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\"{{db}}\", 0, \"{{mobile_token}}\", \"hr.attendance\", \"create\", [{\"check_in\": \"2026-06-06 08:00:00\", \"in_latitude\": 24.7136, \"in_longitude\": 46.6753}]]\n  }\n}" } }
        },
        {
          "name": "hr.leave — search_read",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
