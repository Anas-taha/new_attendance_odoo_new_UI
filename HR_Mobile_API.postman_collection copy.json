            "url": { "raw": "{{base_url}}/mobile/jsonrpc", "host": ["{{base_url}}"], "path": ["mobile","jsonrpc"] },
            "body": { "mode": "raw", "raw": "{\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\"{{db}}\", 0, \"{{mobile_token}}\", \"hr.leave\", \"create\", [{\"holiday_status_id\": 1, \"request_date_from\": \"2026-06-10\", \"request_date_to\": \"2026-06-12\", \"name\": \"Family reasons\"}]]\n  }\n}" } }
        },
        {
          "name": "hr.leave.type — search_read",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/mobile/jsonrpc", "host": ["{{base_url}}"], "path": ["mobile","jsonrpc"] },
