            "body": { "mode": "raw", "raw": "{\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\"{{db}}\", 0, \"{{mobile_token}}\", \"hr.expense\", \"create\", [{\"name\": \"Taxi\", \"total_amount\": 50.0}]]\n  }\n}" } }
        },
        {
          "name": "hr.expense — search_read",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/mobile/jsonrpc", "host": ["{{base_url}}"], "path": ["mobile","jsonrpc"] },
            "body": { "mode": "raw", "raw": "{\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\"{{db}}\", 0, \"{{mobile_token}}\", \"hr.expense\", \"search_read\", [[]], {\"fields\": [\"name\",\"total_amount\",\"state\",\"date\"]}]\n  }\n}" } }
        },
        {
          "name": "hr.payslip — search_read",
