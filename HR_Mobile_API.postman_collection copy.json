        },
        {
          "name": "hr.leave.allocation — search_read",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/mobile/jsonrpc", "host": ["{{base_url}}"], "path": ["mobile","jsonrpc"] },
            "body": { "mode": "raw", "raw": "{\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\"{{db}}\", 0, \"{{mobile_token}}\", \"hr.leave.allocation\", \"search_read\", [[]], {\"fields\": [\"holiday_status_id\",\"number_of_days\",\"state\"]}]\n  }\n}" } }
        },
